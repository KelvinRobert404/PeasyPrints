# Public application and authentication
NEXT_PUBLIC_ALLOWED_ORIGINS=https://peasyprints.example.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me

# Firebase client
NEXT_PUBLIC_FIREBASE_API_KEY=replace_me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_me
NEXT_PUBLIC_FIREBASE_APP_ID=replace_me

# Firebase Admin (keep server-only)
FIREBASE_ADMIN_PROJECT_ID=project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# Payments
RAZORPAY_KEY_ID=rzp_live_replace_me
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Privileged operations
ADMIN_EMAILS=admin@example.com
CRON_SECRET=replace_with_at_least_32_random_characters
CAMPUS_MAINTENANCE_TOKEN=replace_with_at_least_32_random_characters
VIDEO_WORKER_TOKEN=replace_with_at_least_32_random_characters
CAMPUS_ACCOUNT_HOOK_TOKEN=replace_with_at_least_32_random_characters

# Optional analytics; client analytics still require user consent
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ph
POSTHOG_API_KEY=
