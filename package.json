  "private": true,
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "test:rules": "node --test tests/security/firebase-rules.test.mjs",
    "test:campus": "node --test --experimental-strip-types tests/campus/policy.test.ts",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "postinstall": "node -e \"const fs = require('fs'); try { fs.copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs', 'public/pdf.worker.min.mjs'); } catch (e) { console.log('PDF worker copy skipped:', e.message); }\""
  },
